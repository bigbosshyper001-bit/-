# ==============================================================================
# MCU ACADEMIC AFFAIRS PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# มหาวิทยาลัยมหาจุฬาลงกรณราชวิทยาลัย (กองวิชาการ)
# ==============================================================================
# NOTE: DO NOT COMMIT REAL SECRETS TO VERSION CONTROL (GIT).
# Use GCP Secret Manager, Cloud Run Environment Variables, or AI Studio Secrets UI.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT ISOLATION (Development → Staging → Production)
# ------------------------------------------------------------------------------
# APP_ENV: Controls runtime mode and strict data isolation rules.
# Options: 'development' | 'staging' | 'production'
APP_ENV="production"
NODE_ENV="production"

# PORT: Server listener port (Default: 3000 for Cloud Run container standard)
PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION & ISOLATION GUARDS
# ------------------------------------------------------------------------------
# DATABASE_FILE: Path to isolated SQLite persistent database file.
# IMPORTANT: Never point a Development or Staging environment to the Production DB!
# Default paths per environment:
#   - Development: ./data/mcu_academic_dev.sqlite (or ./data/mcu_academic.sqlite)
#   - Staging:     ./data/mcu_academic_staging.sqlite
#   - Production:  ./data/mcu_academic_prod.sqlite
# Guardrail: Development environment automatically blocks any attempt to connect to a production database file.
DATABASE_FILE="./data/mcu_academic_prod.sqlite"

# BACKUP_DIR: Directory where point-in-time snapshots and pre-restore rollback backups are stored
BACKUP_DIR="./data/backups"

# ------------------------------------------------------------------------------
# 3. SECRET MANAGEMENT (Runtime Injection - Never in Source Code)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for AI Assistant & Document Processing.
# Injected automatically at runtime from user secrets / GCP Secret Manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Secret phrase used for signing internal tokens and session cookies
SESSION_SECRET="generate-a-secure-random-64-character-string-here"

# ------------------------------------------------------------------------------
# 4. DOMAIN & HTTPS ROUTING
# ------------------------------------------------------------------------------
# APP_URL: Canonical public URL of the application.
# Must use HTTPS in production. Cloud Run injects this automatically.
APP_URL="https://academic.mcu.ac.th"

# ------------------------------------------------------------------------------
# 5. LOGGING & ERROR MONITORING
# ------------------------------------------------------------------------------
# LOG_LEVEL: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL="info"

# ------------------------------------------------------------------------------
# 6. SUPABASE CLIENT CREDENTIALS
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://geazyjmbxwhwrlwtofvu.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdlYXp5am1ieHdod3Jsd3RvZnZ1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA3MzE3OTYsImV4cCI6MjEwNjMwNzc5Nn0.IXMp6rMu5d_PtBV26hN9ntvS8U-GWuhaVL8hvc2pF9Y"

